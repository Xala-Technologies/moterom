{
  "name": "moterom",
  "version": "1.0.0",
  "description": "Meeting-room booking powered by Digilist",
  "scripts": {
    "dev": "node --watch-path=server --watch-path=src --watch-path=shared --watch-path=config --watch-path=index.html --watch-path=vite.config.ts --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build && node scripts/bundle-api.mjs",
    "start": "NODE_ENV=production node --import tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@digdir/designsystemet-css": "^1.21.1",
    "@digdir/designsystemet-react": "^1.21.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "convex": "^1.45.0",
    "esbuild": "^0.27.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.7",
    "supertest": "^7.2.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  }
}
