# Demo is local and isolated from Digilist. Production defaults to live.
DATA_MODE=demo
PORT=4173
PUBLIC_ORIGIN=http://localhost:4173
# Required in production: a random value with at least 32 characters.
SESSION_SECRET=
# Digilist auth (email/SMS/BankID) needs both URLs even when DATA_MODE=demo.
# Dev example: DIGILIST_URL=https://convex-api.dev.digilist.no
#              DIGILIST_HTTP_URL=https://convex.dev.digilist.no
# Live mode also requires DIGILIST_TENANT_ID and a published slug per room.
DIGILIST_URL=
DIGILIST_HTTP_URL=
DIGILIST_TENANT_ID=
DIGILIST_DASHBOARD_URL=https://dashboard.digilist.no
# Comma-separated Digilist emails allowed to open Møterom Admin.
# Admin also requires an active Digilist tenant role: tenant_admin, saksbehandler,
# or the legacy owner/admin/manager/staff values returned by /auth/me.
ADMIN_EMAILS=skb@digilist.no
# public or members. This portal is login-first; use members so Digilist tenant
# membership controls who can use rooms and booking after sign-in.
BOOKING_ACCESS=members
# SKB live bookings are free/internal. Do not set PAYMENT_MODE=hosted or invoice
# on the SKB live target; paid Digilist quotes fail closed in the BFF.
# PAYMENT_MODE=
# Production demos require an explicit opt-in; never enable this on a live deployment.
ALLOW_DEMO_DEPLOYMENT=false
# Optional: SQLite and room-upload paths (Vercel demo uses /tmp).
# DEMO_DB_PATH=/tmp/demo.sqlite
# DEMO_UPLOAD_DIR=/tmp/rooms
# Access-request inbox (demo and live). Membership is still granted in Digilist.
# ACCESS_REQUESTS_DB_PATH=/tmp/access_requests.sqlite
BUILDING_NAME=Møterom
BUILDING_ADDRESS=
CONTACT_EMAIL=
# Optional private floor plan mounted outside source control (absolute PNG path).
FLOORPLAN_PATH=
# Set live slugs in config/rooms.json. Never put a secret in a VITE_ variable.
# BankID on localhost also needs Digilist EXTRA_CORS_ORIGINS to include PUBLIC_ORIGIN.
